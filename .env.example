# Copia este archivo a .env.local y pega ahí la clave.
# .env.local no se sube a git. Después de guardarlo, reinicia `npm run dev`.
#
# La clave se crea en https://platform.openai.com/api-keys
# El agente usa el modelo gpt-6-luna (GPT-6 Luna).

OPENAI_API_KEY=

# Opcional. Si lo omites, TEO usa gpt-6-luna.
# OPENAI_MODEL=gpt-6-luna
